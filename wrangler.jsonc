{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "heatmap",
    "main": "src/index.js",
    "compatibility_date": "2026-08-26",
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "redact_query_string": false,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": true,
            "persist": true,
            "head_sampling_rate": 1
        }
    }
}